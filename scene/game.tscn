[sub_resource type="GDScript" id="GDScript_aqj0k"]
resource_name = "Transition"
script/source = "extends CanvasLayer


@onready var animation = $AnimationPlayer


func play(anim_name: String, completion: Callable):
	animation.play(anim_name)
	if completion.is_valid():
		if anim_name != await animation.animation_finished: push_warning(\"Transition names don't match\")
		completion.call()
"

