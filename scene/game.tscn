[sub_resource type="GDScript" id="GDScript_aqj0k"]
resource_name = "Transition"
script/source = "extends CanvasLayer


signal faded_in
signal faded_out

@onready var animation = $AnimationPlayer


func fade(out: bool):
	animation.play(\"fade_out\" if out else \"fade_in\")


func _on_animation_player_animation_finished(anim_name):
	match anim_name:
		\"fade_in\":
			faded_in.emit()
		\"fade_out\":
			faded_out.emit()
"

