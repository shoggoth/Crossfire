[sub_resource type="GDScript" id="GDScript_euyn6"]
resource_name = "Idle"
script/source = "extends MobState


@onready var tm = get_meta(\"temp_meta\")
@onready var player_path = get_meta(\"player_path\")

func enter_from(state: State, _params: Dictionary) -> bool:
	change_state(\"Move\", {\"es\" : state, \"tm\" : tm, \"pp\" : player_path })
	return true
"

[sub_resource type="GDScript" id="GDScript_ag24y"]
resource_name = "Move"
script/source = "extends MobState


func enter_from(_state: State, params: Dictionary) -> bool:
	print(\"Move params = \", params)
	return true


func _physics_process(delta):
	move(delta)
	if mob.input.fire:
		sm.enter_state_named(\"Fire\")
"

[sub_resource type="GDScript" id="GDScript_6it8t"]
resource_name = "Fire"
script/source = "extends MobState


func _process(_delta):
	sm.enter_state_named(\"Explode\")
"

[sub_resource type="GDScript" id="GDScript_kmhv7"]
resource_name = "Explode"
script/source = "extends MobState


func enter_from(_state: State, _params: Dictionary) -> bool:
	$AnimationPlayer.connect(\"animation_finished\", func(_n): mob.take_damage(1.0), CONNECT_ONE_SHOT)
	$AnimationPlayer.play(\"explode\")
	return true
"

