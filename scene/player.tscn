[sub_resource type="GDScript" id="GDScript_euyn6"]
resource_name = "Idle"
script/source = "extends MobState


@onready var tm = get_meta(\"temp_meta\")


func enter_from(state: State, params: Dictionary = {}) -> bool:
	#if tm: print(\"Temp Meta\")
	#var player = get_meta(\"mob\")
	#change_state(\"Fire\", {\"player\" : self })
	change_state(\"Move\", {\"player\" : self })
	#print(\"Idle params = \", params)
	#play(\"idle\")
	return true
"

[sub_resource type="GDScript" id="GDScript_ag24y"]
resource_name = "Move"
script/source = "extends MobState


func _physics_process(delta):
	move(delta)
	if mob.input.fire:
		sm.enter_state_named(\"Fire\")
"

[sub_resource type="GDScript" id="GDScript_6it8t"]
resource_name = "Fire"
script/source = "extends MobState


func _physics_process(delta):
	sm.enter_state_named(\"Explode\")
"

[sub_resource type="GDScript" id="GDScript_kmhv7"]
resource_name = "Explode"
script/source = "extends MobState


func enter_from(state: State, params: Dictionary) -> bool:
	$AnimationPlayer.connect(\"animation_finished\", func(_n): sm.enter_state(state), CONNECT_ONE_SHOT)
	$AnimationPlayer.play(\"explode\")
	return true
"

