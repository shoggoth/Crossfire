[sub_resource type="GDScript" id="GDScript_euyn6"]
resource_name = "Idle"
script/source = "extends State


@onready var tm = get_meta(\"temp_meta\")

func enter_from(_state: State, _params: Dictionary) -> bool:
	change_state(\"Move\", {\"player\" : get_meta(\"parent_node\") })
	return true
"

[sub_resource type="GDScript" id="GDScript_ag24y"]
resource_name = "Move"
script/source = "extends State


@export var move_component: MoveComponent

var player: Player


func enter_from(state: State, params: Dictionary) -> bool:
	player = params[\"player\"] as Player
	return super.enter_from(state, params)


func exit_to(to: State) -> bool:
	if to.name == \"Explode\": move_component.stop()
	return super.exit_to(to)


func _physics_process(_delta):
	move_component.move(player, player.input.d_pad)
	if player.input.fire:
		sm.enter_state_named(\"Fire\", { \"player\" : player })
	if player.input.bomb:
		sm.enter_state_named(\"Explode\")
"

[sub_resource type="GDScript" id="GDScript_6it8t"]
resource_name = "Fire"
script/source = "extends State


@export var weapon_component: WeaponComponent

var player: Player


func enter_from(_state: State, params: Dictionary) -> bool:
	player = params[\"player\"] as Player
	return player != null

func _process(_delta):
	if !player.input.fire:
		sm.enter_state_named(\"Move\", { \"player\" : player })
	elif player.input.d_pad && weapon_component.can_fire:
		weapon_component.fire(player, player.input.d_pad)
"

[sub_resource type="GDScript" id="GDScript_kmhv7"]
resource_name = "Explode"
script/source = "extends State


@export var health_component: HealthComponent


func enter_from(_state: State, _params: Dictionary) -> bool:
	$AnimationPlayer.connect(\"animation_finished\", func(_n): health_component.damage(1.0), CONNECT_ONE_SHOT)
	$AnimationPlayer.play(\"explode\")
	return true
"

