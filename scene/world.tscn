[sub_resource type="GDScript" id="GDScript_vw7uf"]
resource_name = "Pickups"
script/source = "extends Marker2D


signal picked_up_lantern(lantern: Pickup)

@export var lantern_scene: PackedScene
@export var grid_spacing = 32.0

var lantern_positions = [Vector2(2, 3), Vector2(4, 3), Vector2(2, 2), Vector2(4, 2)]


func _ready():
	spawn_lanterns()


func reset():
	for i in get_children(): if i is Pickup:
		remove_child(i)
		i.queue_free()
	spawn_lanterns()


func spawn_lanterns():
	var gs = Vector2(grid_spacing, grid_spacing)
	for i in lantern_positions.size():
		var p: Pickup = lantern_scene.instantiate()
		p.position = lantern_positions[i] * gs
		p.type = Pickup.PickupType.LANTERN
		p.name = \"Lantern %d\" % i
		p.score_value = 2 ** i * 100
		if !p.picked_up.is_connected(_on_lantern_picked_up):
			p.picked_up.connect(_on_lantern_picked_up)
		add_child(p)


func update_lanterns():
	for i in lantern_positions.size():
		var lantern = get_node_or_null(\"Lantern %d\" % i)
		if lantern && lantern is Pickup && lantern.type == Pickup.PickupType.LANTERN && !lantern.score_showing:
			var tween = create_tween()
			if Global.toggle_meta(lantern, \"pushed_out\"):
				tween.tween_property(lantern, \"position\", Vector2(0, grid_spacing * 0.5), 0.5).as_relative()
			else:
				tween.tween_property(lantern, \"position\", Vector2(0, -grid_spacing * 0.5), 0.5).as_relative()
			break


func _on_lantern_picked_up(lantern):
	picked_up_lantern.emit(lantern)


func _on_timer_timeout():
	update_lanterns()
"

